{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mcp-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "staging.mcp.messijo.com", "custom_domain": true }],
  "vars": {
    "AUTH_BASE_URL": "https://staging.auth.messijo.com",
    "REST_API_BASE_URL": "https://staging.api.messijo.com",
    "MCP_RESOURCE_URL": "https://staging.mcp.messijo.com/mcp",
    "MCP_PUBLIC_BASE_URL": "https://staging.mcp.messijo.com",
    "INTROSPECTION_CACHE_TTL_SECONDS": "10",
    "JWKS_CACHE_TTL_SECONDS": "300"
  }
}
